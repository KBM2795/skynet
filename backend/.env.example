# ──────────────────────────────────────────────────────────
#  SkyNet Backend — Environment Variables
#  Copy to .env and fill in your Supabase credentials
# ──────────────────────────────────────────────────────────

# Server
PORT=8080
ENV=development

# Supabase PostgreSQL (Connection Pooler)
# Find these in: Supabase Dashboard → Settings → Database → Connection string → Mode: Session
# Use the pooler host (IPv4) instead of the direct host (IPv6-only)
DB_HOST=aws-0-<your-region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-db-password>
DB_NAME=postgres
DB_SSLMODE=require

# Supabase JWT Secret
# Find in: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=